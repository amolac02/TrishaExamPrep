<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stage 6 English: Speech Assessment</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes pulse-ring {
            0% { transform: scale(0.8); opacity: 0.5; }
            100% { transform: scale(1.3); opacity: 0; }
        }
        .loader-ring::before {
            content: '';
            position: absolute;
            left: 0; top: 0; width: 100%; height: 100%;
            border-radius: 50%;
            box-shadow: 0 0 15px #6366f1;
            animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans min-h-screen">

    <div class="max-w-4xl mx-auto p-4 sm:p-6 lg:p-8">
        
        <!-- Header -->
        <header class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-10 mb-8 text-center">
            <div class="inline-flex items-center justify-center p-3 bg-indigo-50 text-indigo-700 rounded-xl mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-2">Advanced Syntax Assessment</h1>
            <h2 class="text-xl text-gray-500 font-medium mb-6">Direct & Indirect Speech (Cambridge Stage 6)</h2>
            <div class="flex flex-wrap justify-center gap-4 text-sm font-semibold">
                <span class="bg-blue-100 text-blue-800 px-4 py-2 rounded-full">Total Marks: 25</span>
                <span class="bg-purple-100 text-purple-800 px-4 py-2 rounded-full">AI Evaluator: Active</span>
                <span class="bg-amber-100 text-amber-800 px-4 py-2 rounded-full">Difficulty: Medium - High</span>
            </div>
            <p class="mt-6 text-gray-600 max-w-2xl mx-auto text-sm">
                <strong>Instructions:</strong> Read each question carefully. Apply the rules of tense backshifting, pronoun changes, spatial/temporal shifts, and proper punctuation. The AI Examiner will evaluate your responses based on strict Cambridge syntactic frameworks.
            </p>
        </header>

        <!-- Exam Form -->
        <form id="exam-form" class="space-y-8">
            
            <!-- Section A -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
                <div class="border-b-2 border-gray-100 pb-4 mb-6">
                    <h3 class="text-lg font-bold text-gray-900 uppercase tracking-wide">Section A: Standard Conversions (10 Marks)</h3>
                    <p class="text-gray-500 text-sm">Convert the following direct speech into indirect (reported) speech. (2 marks each)</p>
                </div>
                
                <div class="space-y-6">
                    <!-- Q1 -->
                    <div>
                        <label class="block font-medium text-gray-900 mb-2">1. "I am building a robot in my garage," said Dr. Vance.</label>
                        <input type="text" name="q1" required class="w-full bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors" placeholder="Type your answer here...">
                    </div>
                    <!-- Q2 -->
                    <div>
                        <label class="block font-medium text-gray-900 mb-2">2. "Water boils at 100 degrees Celsius," the scientist noted.</label>
                        <input type="text" name="q2" required class="w-full bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors" placeholder="Type your answer here...">
                    </div>
                    <!-- Q3 -->
                    <div>
                        <label class="block font-medium text-gray-900 mb-2">3. "Where is the police station?" the civilian asked.</label>
                        <input type="text" name="q3" required class="w-full bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors" placeholder="Type your answer here...">
                    </div>
                    <!-- Q4 -->
                    <div>
                        <label class="block font-medium text-gray-900 mb-2">4. "Do not run in the corridors," the principal ordered the students.</label>
                        <input type="text" name="q4" required class="w-full bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors" placeholder="Type your answer here...">
                    </div>
                    <!-- Q5 -->
                    <div>
                        <label class="block font-medium text-gray-900 mb-2">5. "I will help you tomorrow," he promised her.</label>
                        <input type="text" name="q5" required class="w-full bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors" placeholder="Type your answer here...">
                    </div>
                </div>
            </div>

            <!-- Section B -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
                <div class="border-b-2 border-gray-100 pb-4 mb-6">
                    <h3 class="text-lg font-bold text-gray-900 uppercase tracking-wide">Section B: Advanced Syntactic Shifts (15 Marks)</h3>
                    <p class="text-gray-500 text-sm">Convert the following applying advanced reporting verbs, combating deictic amnesia, and fixing syntax. (3 marks each)</p>
                </div>
                
                <div class="space-y-6">
                    <!-- Q6 -->
                    <div>
                        <label class="block font-medium text-gray-900 mb-2">6. <em>(Deictic Shift)</em> "I wrote a secret letter here today," the spy whispered.</label>
                        <input type="text" name="q6" required class="w-full bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors" placeholder="Type your answer here...">
                    </div>
                    <!-- Q7 -->
                    <div>
                        <label class="block font-medium text-gray-900 mb-2">7. <em>(Advanced Verb - Use 'refused')</em> "I won't do my homework under any circumstances!" the girl yelled.</label>
                        <input type="text" name="q7" required class="w-full bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors" placeholder="Type your answer here...">
                    </div>
                    <!-- Q8 -->
                    <div>
                        <label class="block font-medium text-gray-900 mb-2">8. <em>(Modal Shift & Obligation)</em> "You must pay the fine by 30th April," the officer said to us.</label>
                        <input type="text" name="q8" required class="w-full bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors" placeholder="Type your answer here...">
                    </div>
                    <!-- Q9 -->
                    <div>
                        <label class="block font-medium text-gray-900 mb-2">9. <em>(Interrogative Inversion Trap)</em> "Did you see the suspect running?" the detective asked the witness.</label>
                        <input type="text" name="q9" required class="w-full bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors" placeholder="Type your answer here...">
                    </div>
                    <!-- Q10 -->
                    <div>
                        <label class="block font-medium text-gray-900 mb-2">10. <em>(Punctuation Reverse-Engineering)</em> Convert this indirect speech back to perfectly punctuated DIRECT speech: <br> <span class="text-gray-500 text-sm font-normal">The teacher shouted that they were making too much noise and demanded that they sit down.</span></label>
                        <input type="text" name="q10" required class="w-full bg-gray-50 border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors" placeholder="Type your answer here...">
                    </div>
                </div>
            </div>

            <div class="text-center">
                <button type="submit" id="submit-btn" class="inline-flex items-center justify-center px-8 py-4 text-lg font-bold text-white bg-indigo-600 rounded-xl hover:bg-indigo-700 focus:ring-4 focus:ring-indigo-300 transition-all shadow-lg hover:shadow-xl hover:-translate-y-1">
                    <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Submit for AI Evaluation
                </button>
            </div>
        </form>

        <!-- Loading State -->
        <div id="loading-overlay" class="hidden fixed inset-0 bg-white/90 backdrop-blur-sm z-50 flex flex-col items-center justify-center">
            <div class="relative w-20 h-20 flex items-center justify-center loader-ring bg-indigo-100 rounded-full mb-6">
                <svg class="w-10 h-10 text-indigo-600 animate-spin" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">AI is analyzing your syntax...</h2>
            <p class="text-gray-500">Checking tense backshifts, deictic markers, and punctuation.</p>
        </div>

        <!-- Results Section -->
        <div id="results-section" class="hidden mt-12 bg-white rounded-2xl shadow-xl border-t-8 border-indigo-600 overflow-hidden">
            <div class="p-8 bg-indigo-50 text-center border-b border-indigo-100">
                <h2 class="text-4xl font-black text-gray-900 mb-2">Final Grade</h2>
                <div class="text-6xl font-black text-indigo-600 mt-4 mb-2">
                    <span id="final-score">0</span> <span class="text-3xl text-gray-400">/ 25</span>
                </div>
                <p id="overall-feedback" class="text-lg text-gray-700 font-medium max-w-2xl mx-auto mt-4"></p>
            </div>
            
            <div class="p-6 sm:p-8" id="feedback-container">
                <h3 class="text-xl font-bold text-gray-900 mb-6 uppercase tracking-wide border-b pb-2">Detailed Feedback</h3>
                <!-- Dynamic feedback injected here -->
            </div>
            
            <div class="p-6 bg-gray-50 text-center">
                <button onclick="window.location.reload()" class="font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
                    Retake Assessment
                </button>
            </div>
        </div>

    </div>

    <script>
        // API Configuration setup as per instructions
        const apiKey = ""; // The environment provides the key at runtime

        const systemPrompt = `
You are an expert Cambridge Stage 6 English Examiner. Grade the following Direct/Indirect Speech test. 
The total marks are 25. 
Grade strictly based on the Cambridge framework: tense backshifting, punctuation, universal truths, pronominal shifts, deictic shifts, and interrogative/imperative syntax.

Marking Rubric (Total 25 marks):
Q1 (2m): Dr. Vance said that he was building a robot in his garage. (Past continuous backshift, correct pronouns).
Q2 (2m): The scientist noted that water boils at 100 degrees Celsius. (Universal truth exception - NO backshift).
Q3 (2m): The civilian asked where the police station was. (Declarative word order, no question mark).
Q4 (2m): The principal ordered the students not to run in the corridors. (Infinitive pattern).
Q5 (2m): He promised her that he would help her the next day / the following day. (Modal shift will->would, deictic shift tomorrow->the next day).
Q6 (3m): The spy whispered that he had written a secret letter there that day. (Past to Past Perfect, here->there, today->that day).
Q7 (3m): The girl refused to do her homework (under any circumstances). (Must use 'refused' + to-infinitive).
Q8 (3m): The officer told us that we had to pay the fine by 30th April. (Modal shift must->had to, correct pronouns).
Q9 (3m): The detective asked the witness if/whether they had seen the suspect running. (if/whether bridge, past perfect backshift, NO auxiliary 'did').
Q10 (3m): "You are making too much noise!" shouted the teacher. "Sit down!" (or similar valid direct speech with PERFECT typography: caps, quotes, punctuation inside quotes, no comma splices).

Provide a structured JSON response EXACTLY matching this schema, assigning partial marks if they missed a small rule but got the structure mostly right.
`;

        const jsonSchema = {
            type: "OBJECT",
            properties: {
                totalScore: { type: "INTEGER" },
                evaluations: {
                    type: "ARRAY",
                    items: {
                        type: "OBJECT",
                        properties: {
                            questionNumber: { type: "INTEGER" },
                            scoreAwarded: { type: "INTEGER" },
                            maxScore: { type: "INTEGER" },
                            feedback: { type: "STRING" }
                        }
                    }
                },
                overallFeedback: { type: "STRING" }
            }
        };

        // Exponential Backoff API Call
        async function fetchGeminiEvaluation(studentAnswers, retryCount = 0) {
            const delays = [1000, 2000, 4000, 8000, 16000];
            
            const payload = {
                contents: [{
                    parts: [{ text: `Student Answers:\n${studentAnswers}` }]
                }],
                systemInstruction: {
                    parts: [{ text: systemPrompt }]
                },
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: jsonSchema
                }
            };

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                
                const result = await response.json();
                return JSON.parse(result.candidates[0].content.parts[0].text);
                
            } catch (error) {
                if (retryCount < delays.length) {
                    await new Promise(resolve => setTimeout(resolve, delays[retryCount]));
                    return fetchGeminiEvaluation(studentAnswers, retryCount + 1);
                }
                throw new Error("Evaluation service is currently unavailable. Please try again later.");
            }
        }

        document.getElementById('exam-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new FormData(e.target);
            let studentAnswersText = "";
            for (let [key, value] of formData.entries()) {
                studentAnswersText += `${key.toUpperCase()}: ${value}\n`;
            }

            // UI Transitions
            document.getElementById('submit-btn').disabled = true;
            document.getElementById('loading-overlay').classList.remove('hidden');
            
            try {
                const evaluation = await fetchGeminiEvaluation(studentAnswersText);
                renderResults(evaluation);
            } catch (error) {
                alert(error.message);
                document.getElementById('loading-overlay').classList.add('hidden');
                document.getElementById('submit-btn').disabled = false;
            }
        });

        function renderResults(data) {
            document.getElementById('exam-form').classList.add('hidden');
            document.getElementById('loading-overlay').classList.add('hidden');
            document.getElementById('results-section').classList.remove('hidden');
            
            // Populate overview
            document.getElementById('final-score').innerText = data.totalScore;
            document.getElementById('overall-feedback').innerText = data.overallFeedback;
            
            // Populate specific question feedback
            const container = document.getElementById('feedback-container');
            container.innerHTML = '<h3 class="text-xl font-bold text-gray-900 mb-6 uppercase tracking-wide border-b pb-2">Detailed Feedback</h3>';
            
            data.evaluations.forEach(eval => {
                const isFullMarks = eval.scoreAwarded === eval.maxScore;
                const isZero = eval.scoreAwarded === 0;
                
                let badgeClass = "bg-green-100 text-green-800";
                if (isZero) badgeClass = "bg-red-100 text-red-800";
                else if (!isFullMarks) badgeClass = "bg-yellow-100 text-yellow-800";

                const html = `
                    <div class="mb-6 bg-gray-50 p-4 rounded-xl border border-gray-200">
                        <div class="flex items-center justify-between mb-2">
                            <h4 class="font-bold text-gray-900">Question ${eval.questionNumber}</h4>
                            <span class="${badgeClass} px-3 py-1 rounded-full text-sm font-bold shadow-sm">
                                ${eval.scoreAwarded} / ${eval.maxScore} marks
                            </span>
                        </div>
                        <p class="text-gray-700 text-sm leading-relaxed">${eval.feedback}</p>
                    </div>
                `;
                container.innerHTML += html;
            });

            // Scroll to top to see results
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>
