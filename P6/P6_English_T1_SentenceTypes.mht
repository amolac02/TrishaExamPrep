* { box-sizing: border-box; margin: 0px; padding: 0px; }

html { scroll-behavior: smooth; }

body { min-height: 100vh; background: var(--color-bg); color: var(--color-text); font-family: var(--font-body); font-size: var(--text-base); line-height: 1.65; }

img, svg { display: block; max-width: 100%; }

a { color: inherit; text-decoration: none; }

button { font: inherit; cursor: pointer; border: 0px; background: none; }

table { width: 100%; border-collapse: collapse; }

th, td { text-align: left; vertical-align: top; }

.skip-link { position: absolute; left: -9999px; top: 0px; }

.skip-link:focus { left: var(--space-4); top: var(--space-4); background: var(--color-primary); color: var(--color-text-inverse); padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); z-index: 1000; }

.container { width: min(calc(100% - 2rem), var(--content-default)); margin: 0px auto; }

.site-header { position: sticky; top: 0px; z-index: 100; backdrop-filter: blur(10px); background: color-mix(in srgb, var(--color-bg) 86%, transparent); border-bottom: 1px solid var(--color-divider); }

.nav-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-4) 0; }

.brand { display: flex; align-items: center; gap: var(--space-3); font-size: var(--text-sm); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }

.brand-mark { width: 34px; height: 34px; border: 1px solid var(--color-text); border-radius: 0px; display: grid; place-items: center; }

.brand-mark svg { width: 20px; height: 20px; }

.nav-links { display: flex; gap: var(--space-5); flex-wrap: wrap; align-items: center; font-size: var(--text-sm); color: var(--color-text-muted); }

.nav-links a:hover, .nav-links a:focus-visible { color: var(--color-text); }

.theme-toggle { min-width: 44px; min-height: 44px; display: grid; place-items: center; border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-surface); transition: background var(--transition), border-color var(--transition); }

.theme-toggle:hover { background: var(--color-surface-offset); }

.hero { padding: clamp(var(--space-12), 10vw, var(--space-24)) 0 var(--space-16); border-bottom: 1px solid var(--color-divider); }

.hero-grid { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: var(--space-10); align-items: end; }

.eyebrow { display: inline-block; margin-bottom: var(--space-4); font-size: var(--text-xs); letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-primary); font-weight: 700; }

h1, h2, h3 { font-family: var(--font-display); line-height: 1.08; }

h1 { font-size: var(--text-2xl); max-width: 12ch; margin-bottom: var(--space-5); }

h2 { font-size: var(--text-xl); margin-bottom: var(--space-5); }

h3 { font-size: var(--text-lg); margin-bottom: var(--space-3); }

p { max-width: 70ch; }

.hero-copy p { color: var(--color-text-muted); margin-bottom: var(--space-6); }

.hero-actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }

.btn { min-height: 44px; padding: 0 var(--space-5); display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; border: 1px solid var(--color-border); transition: all var(--transition); font-size: var(--text-sm); font-weight: 700; }

.btn-primary { background: var(--color-primary); color: var(--color-text-inverse); border-color: var(--color-primary); }

.btn-primary:hover { background: var(--color-primary-hover); }

.btn-secondary { background: transparent; color: var(--color-text); }

.btn-secondary:hover { background: var(--color-surface); }

.hero-panel { background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: var(--shadow-md); padding: var(--space-6); border-radius: var(--radius-lg); }

.panel-kicker { font-size: var(--text-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: var(--space-4); }

.stat-list { display: grid; gap: var(--space-4); }

.stat-item { padding-bottom: var(--space-4); border-bottom: 1px solid var(--color-divider); }

.stat-item:last-child { border-bottom: 0px; padding-bottom: 0px; }

.stat-number { font-family: var(--font-display); font-size: var(--text-xl); margin-bottom: var(--space-1); }

.section { padding: clamp(var(--space-10), 7vw, var(--space-20)) 0; border-bottom: 1px solid var(--color-divider); }

.section-intro { margin-bottom: var(--space-8); }

.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); }

.card-grid { display: grid; grid-template-columns: repeat(3, minmax(0px, 1fr)); gap: var(--space-5); }

.card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-5); box-shadow: var(--shadow-sm); }

.card p, .card li { color: var(--color-text-muted); }

.pill { display: inline-flex; align-items: center; padding: 0.32rem 0.7rem; border-radius: 999px; background: var(--color-primary-highlight); color: var(--color-primary); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: var(--space-4); }

.example { padding: var(--space-4); background: var(--color-surface-2); border-left: 3px solid var(--color-primary); border-radius: var(--radius-md); margin-top: var(--space-4); }

.label-subject { color: var(--color-primary); font-weight: 700; }

.label-predicate { color: rgb(47, 91, 136); font-weight: 700; }

[data-theme="dark"] .label-predicate { color: rgb(136, 185, 236); }

.mistake-list, .tip-list, .practice-list { display: grid; gap: var(--space-3); }

.table-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }

th, td { padding: var(--space-4); border-bottom: 1px solid var(--color-divider); }

thead th { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-text-muted); background: var(--color-surface-2); }

tbody tr:last-child td { border-bottom: 0px; }

.diagram { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-5); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.92rem; white-space: pre-wrap; overflow-x: auto; }

.resource-list { display: grid; gap: var(--space-4); }

.resource-item { display: grid; gap: var(--space-2); padding: var(--space-5); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }

.resource-item a { color: var(--color-primary); font-weight: 700; }

.practice-item, .challenge-item { padding: var(--space-5); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }

.answers { margin-top: var(--space-6); padding: var(--space-5); background: var(--color-surface-2); border-radius: var(--radius-lg); border: 1px solid var(--color-border); }

.writing-task { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: var(--space-8); align-items: start; }

.note-box { padding: var(--space-5); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }

ul { padding-left: 1.1rem; }

li + li { margin-top: 0.45rem; }

.footer { padding: var(--space-10) 0; color: var(--color-text-muted); font-size: var(--text-sm); }

.toc { display: grid; grid-template-columns: repeat(5, minmax(0px, 1fr)); gap: var(--space-3); margin-top: var(--space-8); }

.toc a { padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: var(--text-sm); color: var(--color-text-muted); }

.toc a:hover { color: var(--color-text); border-color: var(--color-primary); }

@media (max-width: 960px) {
  .hero-grid, .grid-2, .writing-task { grid-template-columns: 1fr; }
  .card-grid, .toc { grid-template-columns: 1fr 1fr; }
  .nav-links { display: none; }
  h1 { max-width: 100%; }
}

@media (max-width: 640px) {
  .card-grid, .toc { grid-template-columns: 1fr; }
  .hero-actions { flex-direction: column; align-items: stretch; }
  .btn { width: 100%; }
  .container { width: min(calc(100% - 1.25rem), var(--content-default)); }
}
